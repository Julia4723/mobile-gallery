{
  "expo": {
    "name": "Mobile Gallery",
    "slug": "mobile-gallery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.julia4723.mobilegallery",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Приложение отправляет изображения на сервер Mobile Gallery, запущенный на вашем компьютере в этой сети Wi-Fi."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.julia4723.mobilegallery"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Нужно, чтобы выбрать изображения для отправки в Figma.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-dev-client",
      [
        "./plugins/withLocalCleartext",
        {
          "hosts": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cafbf896-b5e2-49a0-be8f-6f1ab9c9ad21"
      }
    }
  }
}
