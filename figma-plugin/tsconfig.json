{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["@figma/plugin-typings", "node"]
  },
  "include": ["src", "test"],
  "exclude": ["src/ui.ts"]
}
